# ---- Gemini access (pick ONE) ------------------------------------------------
# Option A: Google AI Studio API key (local development)
GOOGLE_API_KEY=
# Option B: Vertex AI (recommended for Cloud Run; uses the service account)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Models -------------------------------------------------------------------
MODEL_FAST=gemini-4-neon
MODEL_SMART=gemini-4-neon
MODEL_TTS=gemini-2.5-flash-preview-tts

# ---- Storage (local defaults; deploy script sets the cloud values) ------------
STORAGE_BACKEND=local          # local | gcs
JOBSTORE_BACKEND=sqlite        # sqlite | firestore
# GCS_BUCKET=my-bucket

# ---- Limits -------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
MAX_FILES_PER_JOB=500
MAX_VIDEO_MB=1024
